{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salento.dev/brand/schema/group.schema.json",
  "title": "Gruppo WhatsApp Salento.dev",
  "description": "Generato da src/schema.js con `npm run schema`: non modificare a mano.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Nome del gruppo come appare su WhatsApp (max 32)."
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 14,
      "description": "Nome breve (max 14) per galleria, testo alternativo e documentazione. Non è disegnato sull'icona."
    },
    "kind": {
      "type": "string",
      "enum": [
        "permanent",
        "temporary"
      ],
      "description": "permanent = gruppo stabile; temporary = legato a un evento/periodo."
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Soggetto centrale: nome di un file in assets/subjects/<nome>.svg (es. coffee-cup)."
    },
    "accent": {
      "description": "Solo permanent (obbligatorio): colore del gruppo, uno tra cyan, violet, fuchsia, emerald, lime. I temporary usano sempre la pietra.",
      "type": "string",
      "enum": [
        "cyan",
        "violet",
        "fuchsia",
        "emerald",
        "lime"
      ]
    },
    "doodles": {
      "description": "Doodle del wallpaper tipici del gruppo (max 10), nomi di file in assets/doodles/. Si aggiungono al set comune.",
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "description": {
      "description": "Descrizione breve (italiano).",
      "type": "string",
      "maxLength": 280
    },
    "starts": {
      "description": "Solo temporary: data di inizio (AAAA-MM-GG).",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "ends": {
      "description": "Solo temporary: data di fine (AAAA-MM-GG), >= starts.",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "status": {
      "default": "active",
      "description": "archived = gruppo chiuso, non più generato.",
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "example": {
      "description": "true se il file è solo un esempio dimostrativo.",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "shortName",
    "kind",
    "subject"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "temporary"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "starts",
          "ends"
        ],
        "not": {
          "required": [
            "accent"
          ]
        }
      },
      "else": {
        "required": [
          "accent"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "starts"
              ]
            },
            {
              "required": [
                "ends"
              ]
            }
          ]
        }
      }
    }
  ]
}
